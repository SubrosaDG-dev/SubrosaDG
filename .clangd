If:
  PathMatch: [
    build/.*,
    libs/.*,
  ]
CompileFlags:
  Remove: [
    -W*,
  ]
Diagnostics:
  ClangTidy:
    Remove: '*'

---

CompileFlags:
  # clangd parses the source without generating device binaries.
  Remove: [
    -fsycl-targets=*,
  ]
Completion:
  ArgumentLists: Delimiters
  HeaderInsertion: Never
